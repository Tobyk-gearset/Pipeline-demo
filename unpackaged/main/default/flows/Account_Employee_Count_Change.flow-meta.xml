        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 30</expression>
    </formulas>
    <formulas>
        <name>High_Priority_Opp_Name</name>
        <dataType>String</dataType>
        <expression>&quot;High-Priority Expansion - &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Opp_Description</name>
        <dataType>String</dataType>

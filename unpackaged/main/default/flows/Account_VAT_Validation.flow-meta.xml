        </defaultConnector>
        <defaultConnectorLabel>Format Invalid</defaultConnectorLabel>
        <rules>
            <name>Format_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Format_Check</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Validation_Result</targetReference>
            </connector>
            <label>Format Valid</label>
        </rules>
    </decisions>

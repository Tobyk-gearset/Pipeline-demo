    <description>Record-triggered Flow on Account that fires after save when VAT_Number__c is populated and changed. Validates the VAT number format locally and checks the result from the external validation service. Updates the validation status fields and creates a Task for the finance team when validation fails. Non-blocking to sales reps. To enable external validation, add an Apex Action element calling VATValidationService before the Check Validation Result decision.</description>
    <formulas>
        <name>Current_DateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>Format_Check</name>
        <dataType>Boolean</dataType>
        <expression>REGEX({!$Record.VAT_Number__c}, "[A-Za-z]{2}[A-Za-z0-9]{2,}")</expression>
    </formulas>
    <formulas>
        <name>Task_Subject</name>
        <dataType>String</dataType>
        <expression>"VAT Validation Failed - " &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>Validation_Result_Status</name>
        <dataType>String</dataType>
        <expression>"Pending"</expression>
    </formulas>
    <interviewLabel>Account VAT Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account VAT Validation</label>
